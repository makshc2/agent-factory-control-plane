VITE_APP_TITLE=Factory Control Plane

# Default GitHub token; use a read-only or fine-grained token
VITE_GITHUB_TOKEN=

# Default GitLab token; use a read-only or fine-grained token
VITE_GITLAB_TOKEN=

# GitLab API base URL; self-hosted instances may block browser CORS
VITE_GITLAB_BASE_URL=https://gitlab.com

# Board polling interval in milliseconds
VITE_POLL_INTERVAL_MS=60000
